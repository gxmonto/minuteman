# Normally the first-run setup writes .env for you. Use this as a reference for servers/containers.
# Never commit real values.
DB_URL=jdbc:mysql://localhost:3306/timetracker?createDatabaseIfNotExist=true
DB_USERNAME=timetrack
DB_PASSWORD=change-me
# At least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string-of-32-bytes-or-more
# Creates the first admin if the users table is empty
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-too

APP_LOCALE=es

# Push notifications (Firebase Cloud Messaging)
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json

# Bitrix24 connector (optional)
BITRIX24_ENABLED=false
BITRIX24_WEBHOOK_URL=https://your-portal.bitrix24.com/rest/1/xxxxxxxxxxxx/
BITRIX24_SITE_FIELD=
